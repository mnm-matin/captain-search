# Captain Search Configuration Example
# Copy this file to .env and fill in your API keys

# =============================================================================
# API Keys (at least one required)
# =============================================================================

# Serper.dev - 2,500 searches/month free
# Get your key at: https://serper.dev
SERPER_API_KEY=

# Brave Search - 2,000 queries/month free
# Get your key at: https://brave.com/search/api/
BRAVE_API_KEY=

# Tavily - 1,000 searches/month free
# Get your key at: https://tavily.com
TAVILY_API_KEY=
# Optional: Second Tavily key for rotation (doubles your quota)
TAVILY_API_KEY_2=

# Exa - optional hosted API key for direct Exa access
# Get your key at: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Perplexity - Requires Pro subscription (~$5/month credit)
# Get your key at: https://perplexity.ai (Pro subscription required)
PERPLEXITY_API_KEY=

# Jina Reader - 20 req/min free (no key required, but removes rate limit)
# Get your key at: https://jina.ai/reader/
JINA_API_KEY=

# Morph Warp Grep - optional repo-scoped code search
# Get your key at: https://www.morphllm.com
MORPH_API_KEY=
# Optional: Override the Morph API base URL
MORPH_BASE_URL=https://api.morphllm.com

# =============================================================================
# Server Configuration
# =============================================================================

# Request timeout in seconds (default: 30)
SEARCH_TIMEOUT_SECONDS=30

# MCP server settings
MCP_SERVER_NAME=search_mcp
MCP_SERVER_PORT=8000

# =============================================================================
# Telemetry / Logging
# =============================================================================

# Write structured JSONL logs for tool inputs, outputs, provider attempts,
# repo resolution, and fetch fallback stages.
CAPTAIN_SEARCH_LOG_ENABLED=true

# Daily JSONL log directory.
CAPTAIN_SEARCH_LOG_DIR=~/.captain-search/logs

# When true, log full queries and outputs instead of previews/summaries.
CAPTAIN_SEARCH_LOG_FULL_PAYLOADS=false

# Optional: protect the remote MCP endpoint with a static bearer token.
#
# - If unset/empty, the server runs without authentication.
# - If set, clients must send `Authorization: Bearer <token>`.
# - Multiple tokens can be provided (comma-separated) for rotation.
#
# Example:
# MCP_AUTH_TOKEN=your-secret-token
MCP_AUTH_TOKEN=
